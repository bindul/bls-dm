{
    "$id": "https://bls.bindul.name/data/leagues-index.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Bowling Leagues",
    "description": "BLS Data - Bowling Leagues",
    "type": "object",
    "properties": {
        "bls-version": { "$ref": "types.schema.json#/$defs/bls-version" },
        "seasons": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/season"
            },
            "minItems": 1
        }
    },
    "required": ["bls-version", "seasons"],
    "$defs": {
        "season": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}$"
                },
                "leagues": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/league"
                    },
                    "minItems": 1
                }
            },
            "required": ["id", "leagues"]
        },
        "league": {
            "type": "object",
            "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "ongoing": {
                    "type": "boolean",
                    "default": true
                },
                "location": {
                    "$ref": "#/$defs/location"
                },
                "data-loc": { "type": "string" },
                "teams": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "id": { "type": "string" },
                            "name": { "type": "string" }
                        },
                        "required": ["id"]
                    },
                    "minItems": 1
                }
            },
            "required": ["id", "name", "data-loc", "teams"]
        },
        "location": {
            "type": "object",
            "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" }
            },
            "required": ["id", "name"]
        }
    }
}