    xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
    fx:controller="name.bindul.bls.dm.ui.jfx.components.ApplicationLayoutController">
    <children>
        <fx:include source="menu/application-menu.fxml" />
